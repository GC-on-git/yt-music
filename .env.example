# Local SQLite database
DATABASE_PATH=data/organizer.db

# Google OAuth (create your own client — see docs/setup.md)
YTMUSIC_AUTH_MODE=oauth
YTMUSIC_AUTH_FILE=data/oauth.json
YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=
YTMUSIC_BRAND_ACCOUNT=

# Request behavior
LOG_LEVEL=INFO
YTMUSIC_REQUEST_TIMEOUT_SECONDS=60
YTMUSIC_MAX_RETRIES=3
YTMUSIC_RETRY_BACKOFF_SECONDS=2
# Set true only if you need category/topic music filters (uses more API quota)
YTMUSIC_FETCH_VIDEO_DETAILS=false

# Optional: Smart Assign
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
